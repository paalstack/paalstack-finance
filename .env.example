# ──────────────────────────────────────────────────────────────────────────────
# PaalStack Finance — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEXT_PUBLIC_* variables are exposed to the browser.
# All variables are validated at startup via @t3-oss/env-nextjs + Zod.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PaalStack Finance"
NEXT_PUBLIC_DEBUG_MODE=false

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and keys from:
# https://supabase.com/dashboard/project/<id>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Personal access token for migrations only — never sent to browser
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── Database (Drizzle ORM) ────────────────────────────────────────────────────
# Supabase transaction pooler (port 6543) — for serverless/API routes
# Supabase session pooler  (port 5432) — for drizzle-kit migrations
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── AI Assistant (optional) ───────────────────────────────────────────────────
# Leave unset to keep the AI assistant disabled — lib/ai fails loudly (502)
# instead of returning fake data when these are missing.
#
# AI_PROVIDER selects an OpenAI-compatible endpoint:
#   openrouter — https://openrouter.ai/keys        (many free models, e.g. below)
#   nvidia     — https://build.nvidia.com/          (NIM free tier)
#   openai     — https://platform.openai.com/api-keys
AI_PROVIDER=openrouter
AI_API_KEY=
# Free OpenRouter models worth trying: "meta-llama/llama-3.3-70b-instruct:free",
# "google/gemini-2.0-flash-exp:free", "deepseek/deepseek-chat-v3-0324:free"
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Override only if you need a custom/self-hosted OpenAI-compatible base URL.
AI_BASE_URL=

# ── Email delivery via Resend (optional) ──────────────────────────────────────
# Leave unset to disable email invites — invite creation still succeeds and
# returns a shareable accept link; email delivery is skipped with a warning.
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="PaalStack Finance <onboarding@paalstack.com>"

# ── Error monitoring via Sentry (optional) ────────────────────────────────────
# Leave unset to disable Sentry entirely (no-op, zero overhead).
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed in CI, to upload source maps for readable stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Product analytics via PostHog (optional) ──────────────────────────────────
# Leave unset to disable analytics entirely.
# Get your key from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Billing via Stripe (optional) ─────────────────────────────────────────────
# Leave unset to disable billing — subscription actions throw a clear error
# instead of silently no-oping. Checkout/Portal are Stripe-hosted redirects
# (no Stripe.js/Elements on our side), so only the secret key is needed —
# no NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
# Get your key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From the Stripe CLI (`stripe listen --print-secret`) or Dashboard webhook config
STRIPE_WEBHOOK_SECRET=
# Price IDs from https://dashboard.stripe.com/products
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
